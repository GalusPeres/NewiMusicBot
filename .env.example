# Discord bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
COMMAND_PREFIX=.
BOT_USERNAME=NewiMusicBot
LOG_LEVEL=info

# External Lavalink instance
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=

# Playback and behavior
DEFAULT_SEARCH_PLATFORM=ytsearch
DEFAULT_VOLUME=40
LAVALINK_TIMEOUT_MS=15000
CONNECTION_TIMEOUT_MS=7000
COMMAND_COOLDOWN_MS=2000
LAVALINK_RETRY_DELAY_MS=5000
LAVALINK_RETRY_COUNT=3
MAX_PLAYLIST_SIZE=50
MAX_SEARCH_RESULTS=10
FAST_MODE_ENABLED=true
UI_UPDATE_INTERVAL_MS=3000
FAST_UI_UPDATES=true
PROGRESS_BAR_LENGTH=18
MAX_DISPLAY_TRACKS=10
AUTO_UI_CLEANUP=true
AUTO_DISCONNECT_DELAY_MS=300000
PAUSE_TIMEOUT_MS=1200000
VOLUME_STEP=5
PREBUFFER_NEXT=true
SMART_VOLUME_CONTROL=true
CACHE_ENABLED=true
CACHE_SEARCH_RESULTS=true
CACHE_TTL_SECONDS=300
MAX_CACHE_SIZE=500
TRACK_QUALITY_CACHE=true
MAX_CONCURRENT_SEARCHES=3
MAX_QUEUE_SIZE=1000
MAX_PREVIOUS_TRACKS=50

# Optional Discord application emoji IDs
EMOJI_PREVIOUS_ID=
EMOJI_PLAYPAUSE_ID=
EMOJI_SKIP_ID=
EMOJI_SHUFFLE_ID=
EMOJI_STOP_ID=
EMOJI_YT_ID=
EMOJI_YTM_ID=

# Optional Botboard API. Omit these variables to run without the dashboard.
# When enabled, BOT_API_TOKEN must match the value configured in Botboard.
BOT_API_TOKEN=
BOT_API_PORT=3001
